{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "includes": ["**", "!**/drizzle", "!apps/web/public", "!**/*.json"]
  },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 120 },
  "linter": {
    "rules": {
      "preset": "recommended",
      "correctness": { "useExhaustiveDependencies": "error", "useHookAtTopLevel": "error" },
      "style": { "noNonNullAssertion": "off" }
    }
  },
  "javascript": { "formatter": { "quoteStyle": "double", "trailingCommas": "all" } },
  "overrides": [
    {
      "includes": ["**/test/**", "**/*.test.ts", "e2e/**"],
      "linter": {
        "rules": {
          "suspicious": { "noExplicitAny": "off" },
          "performance": { "useDomNodeTextContent": "off" }
        }
      }
    }
  ]
}
