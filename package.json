{
  "name": "terranova",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "build": "bun run --filter '@terranova/web' build",
    "demo": "ALARM_EVERY_MIN=1 WATERING_DURATION_SEC=15 SIM_SOIL_DRY_RATE=0.3 bun run dev"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^7.0.2"
  }
}
